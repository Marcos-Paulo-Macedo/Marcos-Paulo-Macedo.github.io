/* =====================================================================
   TABELA DE DADOS (COLETA / SCRAPING)
   ===================================================================== */
function tableCols(f) {
    if (state.tblCols) return state.tblCols;
    const keys = activeFields(f).filter(k => !GW.includes(k) && !(f.split && FIN.includes(k)));
    let cols = keys.map(k => ({ k, h: FDEF[k].col || k }));
    if (!f.split) cols.push({ k: '__status', h: 'Status' });
    if (f.shuffle) cols = shuffle(cols);
    cols.unshift({ k: '__id', h: 'ID' }); cols.push({ k: '__int', h: 'Interno', hidden: true });
    state.tblCols = cols; return cols;
}

function ensureTable() {
    const f = curLevel().flags;
    if (!f.table) { hide('table-card'); return; }
    show('table-card');
    if (!state.tbl) state.tbl = { page: 0, sort: null, dir: 1, filter: '' };
    $('tbl-filter').value = state.tbl.filter;
    drawTable();
}

function drawTable() {
    const cols = tableCols(curLevel().flags), t = state.tbl;
    let rows = state.dataset.map((r, i) => ({ r, i }));
    const cell = (o, c) => c.k === '__id' ? String(o.i + 1) : c.k === '__status' ? o.r.raw.Status : c.k === '__int' ? 'x' + (o.i * 7919 % 1000) : o.r[c.k];
    const q = norm(t.filter);
    if (q) rows = rows.filter(o => cols.some(c => norm(cell(o, c)).includes(q)));
    if (t.sort) { const c = cols.find(x => x.k === t.sort); rows.sort((a, b) => String(cell(a, c)).localeCompare(String(cell(b, c)), 'pt', { numeric: true }) * t.dir); }
    const pages = Math.max(1, Math.ceil(rows.length / PAGE));
    t.page = Math.min(t.page, pages - 1);
    const view = rows.slice(t.page * PAGE, t.page * PAGE + PAGE);
    $('data-table').innerHTML =
        `<thead><tr>${cols.map(c => `<th data-col="${c.k}" class="${c.hidden ? 'col-hide' : ''}">${c.h}${t.sort === c.k ? (t.dir > 0 ? ' ▲' : ' ▼') : ''}</th>`).join('')}</tr></thead>` +
        `<tbody>${view.map(o => `<tr data-row="${o.i}">${cols.map(c => `<td class="${c.hidden ? 'col-hide' : ''}">${cell(o, c)}</td>`).join('')}</tr>`).join('')}</tbody>`;
    $('tbl-page').innerText = `Página ${t.page + 1} de ${pages}`;
    $('tbl-prev').disabled = t.page === 0; $('tbl-next').disabled = t.page >= pages - 1;
}

/* =====================================================================
   COMPONENTES DO FORMULÁRIO
   ===================================================================== */
function enableDrag(c, itemSel, onDrop) {
    c.addEventListener('mousedown', e => {
        if (e.button !== 0) return;
        const item = e.target.closest(itemSel);
        if (!item || !c.contains(item)) return;
        e.preventDefault();
        item.classList.add('dragging');
        const doc = item.ownerDocument;
        const up = ev => {
            doc.removeEventListener('mouseup', up, true);
            item.classList.remove('dragging');
            const root = item.getRootNode();
            const t = root && root.elementFromPoint ? root.elementFromPoint(ev.clientX, ev.clientY) : null;
            onDrop(item, t, ev);
        };
        doc.addEventListener('mouseup', up, true);
    });
}

function compCtl(key, id) {
    const d = FDEF[key], opts = d.opts || [];
    let c = mk('div', 'cmp'); c.id = id; c.setAttribute('data-kind', d.kind);
    switch (d.kind) {
        case 'checklist': {
            c.classList.add('cmp-list');
            c.innerHTML = opts.map(o => `<label class="cmp-row"><input type="checkbox" value="${o}"><span>${o}</span></label>`).join('');
            const bx = () => [...c.querySelectorAll('input')];
            c.__get = () => bx().filter(b => b.checked).map(b => b.value).join(',');
            c.__set = v => { const s = v ? v.split(',') : []; bx().forEach(b => { b.checked = s.includes(b.value); }); };
            break;
        }
        case 'multiselect': {
            c = mk('select', 'input-base'); c.id = id; c.multiple = true; c.size = opts.length; c.setAttribute('data-kind', d.kind);
            c.innerHTML = opts.map(o => `<option value="${o}">${o}</option>`).join('');
            c.__get = () => [...c.selectedOptions].map(x => x.value).join(',');
            c.__set = v => { const s = v ? v.split(',') : []; [...c.options].forEach(o => { o.selected = s.includes(o.value); }); };
            break;
        }
        case 'dropradio': {
            c.classList.add('dd');
            c.innerHTML = `<button type="button" class="dd-trigger">Selecione...</button><div class="dd-panel hidden">${opts.map(o => `<label class="cmp-row"><input type="radio" name="${id}_r" value="${o}"><span>${o}</span></label>`).join('')}</div>`;
            const tr = c.querySelector('.dd-trigger'), pn = c.querySelector('.dd-panel');
            tr.addEventListener('click', () => pn.classList.toggle('hidden'));
            c.addEventListener('change', () => { const r = c.querySelector('input:checked'); tr.textContent = r ? r.value : 'Selecione...'; pn.classList.add('hidden'); });
            c.__get = () => { const r = c.querySelector('input:checked'); return r ? r.value : ''; };
            c.__set = v => { const r = c.querySelector(`input[value="${v}"]`); if (r) { r.checked = true; tr.textContent = v; } };
            break;
        }
        case 'dropcheck': {
            c.classList.add('dd');
            c.innerHTML = `<button type="button" class="dd-trigger">Selecione...</button><div class="dd-panel hidden">${opts.map(o => `<label class="cmp-row"><input type="checkbox" value="${o}"><span>${o}</span></label>`).join('')}</div>`;
            const tr = c.querySelector('.dd-trigger'), pn = c.querySelector('.dd-panel');
            const bx = () => [...c.querySelectorAll('input')];
            const label = () => { const n = bx().filter(b => b.checked).length; tr.textContent = n ? `${n} selecionado(s)` : 'Selecione...'; };
            tr.addEventListener('click', () => pn.classList.toggle('hidden'));
            c.addEventListener('change', label);
            c.__get = () => bx().filter(b => b.checked).map(b => b.value).join(',');
            c.__set = v => { const s = v ? v.split(',') : []; bx().forEach(b => { b.checked = s.includes(b.value); }); label(); };
            break;
        }
        case 'combo': {
            c.classList.add('combo');
            c.innerHTML = `<input type="text" class="input-base" autocomplete="off" role="combobox" placeholder="Digite para buscar..."><ul class="combo-list hidden" role="listbox"></ul>`;
            const inp = c.querySelector('input'), ul = c.querySelector('ul');
            const match = t => opts.find(o => stripAcc(o) === stripAcc(t));
            const refresh = () => { const t = stripAcc(inp.value); const m = opts.filter(o => t && stripAcc(o).includes(t)); ul.innerHTML = m.map(o => `<li role="option" data-v="${o}">${o}</li>`).join(''); ul.classList.toggle('hidden', !m.length); };
            inp.addEventListener('input', refresh);
            inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); const f = ul.querySelector('li'); if (f) inp.value = f.dataset.v; ul.classList.add('hidden'); } });
            ul.addEventListener('click', e => { const li = e.target.closest('li'); if (li) { inp.value = li.dataset.v; ul.classList.add('hidden'); } });
            c.__get = () => match(inp.value) || '';
            c.__set = v => { inp.value = v || ''; };
            break;
        }
        case 'slider': {
            c.classList.add('slider');
            c.innerHTML = `<input type="range" min="0" max="20" step="1" value="0"><output>0</output>`;
            const r = c.querySelector('input'), o = c.querySelector('output');
            r.addEventListener('input', () => { o.textContent = r.value; });
            c.__get = () => r.value;
            c.__set = v => { r.value = v; o.textContent = r.value; };
            break;
        }
        case 'toggle': {
            c.classList.add('switch-wrap');
            c.innerHTML = `<button type="button" role="switch" aria-checked="false" class="switch"><span class="knob"></span></button><span class="switch-text">Desligado</span>`;
            const b = c.querySelector('button'), t = c.querySelector('.switch-text');
            const set = on => { b.setAttribute('aria-checked', on ? 'true' : 'false'); b.classList.toggle('on', on); t.textContent = on ? 'Ligado' : 'Desligado'; };
            b.addEventListener('click', () => set(b.getAttribute('aria-checked') !== 'true'));
            c.__get = () => b.getAttribute('aria-checked') === 'true' ? 'Yes' : 'No';
            c.__set = v => set(v === 'Yes');
            break;
        }
        case 'stars': {
            c.classList.add('stars'); let val = '';
            c.innerHTML = [1, 2, 3, 4, 5].map(n => `<button type="button" class="star" data-v="${n}" aria-label="${n} estrela${n > 1 ? 's' : ''}">★</button>`).join('');
            const paint = () => c.querySelectorAll('.star').forEach(s => s.classList.toggle('on', !!val && +s.dataset.v <= +val));
            c.addEventListener('click', e => { const s = e.target.closest('.star'); if (s) { val = s.dataset.v; paint(); } });
            c.__get = () => val;
            c.__set = v => { val = v || ''; paint(); };
            break;
        }
        case 'date': case 'time': case 'color': {
            c = mk('input', 'input-base'); c.id = id; c.type = d.kind; c.setAttribute('data-kind', d.kind);
            if (d.kind === 'color') c.value = '#000000';
            c.__get = () => d.kind === 'color' ? c.value.toLowerCase() : c.value;
            c.__set = v => { if (v) c.value = v; };
            break;
        }
        case 'textarea': {
            c = mk('textarea', 'input-base'); c.id = id; c.rows = 2; c.setAttribute('data-kind', d.kind);
            c.__get = () => c.value.trim();
            c.__set = v => { c.value = v || ''; };
            break;
        }
        case 'stepper': {
            c.classList.add('stepper'); let n = 0;
            c.innerHTML = `<button type="button" class="st-minus" aria-label="Diminuir">−</button><output>0</output><button type="button" class="st-plus" aria-label="Aumentar">+</button>`;
            const o = c.querySelector('output');
            const up = delta => { n = Math.max(0, Math.min(20, n + delta)); o.textContent = n; };
            c.querySelector('.st-minus').addEventListener('click', () => up(-1));
            c.querySelector('.st-plus').addEventListener('click', () => up(1));
            c.__get = () => String(n);
            c.__set = v => { n = +v || 0; o.textContent = n; };
            break;
        }
        case 'segmented': {
            c.classList.add('seg'); c.setAttribute('role', 'radiogroup'); let val = '';
            c.innerHTML = opts.map(o => `<button type="button" class="seg-btn" role="radio" aria-checked="false" data-v="${o}">${o}</button>`).join('');
            const paint = () => c.querySelectorAll('.seg-btn').forEach(b => { const on = b.dataset.v === val; b.classList.toggle('on', on); b.setAttribute('aria-checked', on ? 'true' : 'false'); });
            c.addEventListener('click', e => { const b = e.target.closest('.seg-btn'); if (b) { val = b.dataset.v; paint(); } });
            c.__get = () => val;
            c.__set = v => { val = v || ''; paint(); };
            break;
        }
        case 'pin': {
            c.classList.add('pin');
            c.innerHTML = [0, 1, 2, 3].map(i => `<input type="text" inputmode="numeric" maxlength="1" class="pin-box" aria-label="Dígito ${i + 1}">`).join('');
            const bx = [...c.querySelectorAll('input')];
            bx.forEach((b, i) => {
                b.addEventListener('input', () => { b.value = b.value.replace(/\D/g, ''); if (b.value && bx[i + 1]) bx[i + 1].focus(); });
                b.addEventListener('keydown', e => { if (e.key === 'Backspace' && !b.value && bx[i - 1]) bx[i - 1].focus(); });
            });
            c.__get = () => bx.map(b => b.value).join('');
            c.__set = v => bx.forEach((b, i) => { b.value = (v || '')[i] || ''; });
            break;
        }
        case 'tags': {
            c.classList.add('tags'); let tags = [];
            c.innerHTML = `<div class="tag-chips"></div><input type="text" class="tag-input" placeholder="Digite e pressione Enter" autocomplete="off">`;
            const chips = c.querySelector('.tag-chips'), inp = c.querySelector('input');
            const draw = () => {
                chips.innerHTML = '';
                tags.forEach(t => {
                    const s = mk('span', 'chip', `${t} <button type="button" class="chip-x" aria-label="Remover ${t}">×</button>`);
                    s.querySelector('button').addEventListener('click', () => { tags = tags.filter(x => x !== t); draw(); });
                    chips.appendChild(s);
                });
            };
            const add = () => { const v = inp.value.trim().toLowerCase().replace(/,/g, ''); if (v && !tags.includes(v)) { tags.push(v); draw(); } inp.value = ''; };
            inp.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); add(); } });
            c.__get = () => tags.slice().sort().join(',');
            c.__set = v => { tags = v ? v.split(',') : []; draw(); };
            break;
        }
        case 'dragzone': {
            c.classList.add('dnd');
            c.innerHTML = `<div><div class="dnd-title">Disponíveis</div><div class="dnd-src" data-zone="src"></div></div><div><div class="dnd-title">Prioridade (1º → último)</div><div class="dnd-zone" data-zone="dst"></div></div>`;
            const src = c.querySelector('.dnd-src'), dst = c.querySelector('.dnd-zone');
            shuffle(opts).forEach(o => { const it = mk('div', 'dnd-item', o); it.dataset.v = o; src.appendChild(it); });
            enableDrag(c, '.dnd-item', (item, target) => {
                const zone = target && target.closest('[data-zone]');
                if (!zone || !c.contains(zone)) return;
                const over = target.closest('.dnd-item');
                if (over === item) return;
                if (over && zone.contains(over)) zone.insertBefore(item, over); else zone.appendChild(item);
            });
            c.__get = () => [...dst.querySelectorAll('.dnd-item')].map(x => x.dataset.v).join('>');
            c.__set = v => {
                [...c.querySelectorAll('.dnd-item')].forEach(it => src.appendChild(it));
                (v ? v.split('>') : []).forEach(w => { const it = [...c.querySelectorAll('.dnd-item')].find(x => x.dataset.v === w); if (it) dst.appendChild(it); });
            };
            break;
        }
        case 'sortlist': {
            c.classList.add('sortl');
            c.innerHTML = `<div class="dnd-title">Lista (1º no topo)</div><ol class="sort-ol"></ol>`;
            const ol = c.querySelector('ol');
            shuffle(opts).forEach(o => { const li = mk('li', 'dnd-item sort-item', o); li.dataset.v = o; ol.appendChild(li); });
            enableDrag(c, '.sort-item', (item, target, ev) => {
                const over = target && target.closest('.sort-item');
                if (!over || over === item || !ol.contains(over)) return;
                const r = over.getBoundingClientRect();
                if (ev.clientY < r.top + r.height / 2) ol.insertBefore(item, over); else ol.insertBefore(item, over.nextSibling);
            });
            c.__get = () => [...ol.children].map(x => x.dataset.v).join('>');
            c.__set = v => { (v ? v.split('>') : []).forEach(w => { const li = [...ol.children].find(x => x.dataset.v === w); if (li) ol.appendChild(li); }); };
            break;
        }
    }
    return c;
}

/* Widgets que escondem um código por fatura (para os campos *Code) */
