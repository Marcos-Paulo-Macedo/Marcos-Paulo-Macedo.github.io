function freshState(level) {
    return {
        level, row: 0, step: 1, dataset: [], results: [], startTime: null, timerInt: null, sessionInt: null, intTimer: null,
        idMap: {}, renderedKeys: [], isSubmitting: false, rootNode: null, iframeRef: null, mouseMoves: 0, rowStartTime: 0,
        draft: {}, hp: false, phase: 'idle', view: 'form', session: { active: false, expiresAt: 0 }, csrf: '', code: '', codeExp: 0, codeFails: 0,
        sent: 0, unwanted: [], validationErrors: 0, expirations: 0, downloads: 0, interrupts: 0, loginFails: 0,
        recordActive: false, reportEval: null, renderToken: 0, log: [], tbl: null, tblCols: null
    };
}
let state = freshState(1);
let rng = Math.random;

function mulberry32(a) { return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
function hashStr(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }
function setSeed() { const s = $('opt-seed').value.trim(); rng = s ? mulberry32(hashStr(s)) : Math.random; }
function pick(a) { return a[Math.floor(rng() * a.length)]; }
function shuffle(a, r) { r = r || Math.random; const b = a.slice(); for (let i = b.length - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [b[i], b[j]] = [b[j], b[i]]; } return b; }
function subset(arr, min, max) { const n = min + Math.floor(rng() * (max - min + 1)); const idx = shuffle(arr.map((_, i) => i), rng).slice(0, n).sort((a, b) => a - b); return idx.map(i => arr[i]).join(','); }
const pad2 = n => String(n).padStart(2, '0');
function genId() { return 'id_' + Math.random().toString(36).substr(2, 9); }
function stripAcc(s) { return String(s == null ? '' : s).normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toUpperCase(); }
const norm = s => String(s == null ? '' : s).trim().toLowerCase();
const curLevel = () => LEVELS.find(l => l.id === state.level);
function log(type, data) { state.log.push(Object.assign({ t: Date.now(), type }, data || {})); }
function show(id) { $(id).classList.remove('hidden'); }
function hide(id) { $(id).classList.add('hidden'); }
function hideAllScreens() { ['screen-start', 'screen-loading', 'screen-login', 'screen-form', 'screen-upload', 'screen-blocked', 'screen-results'].forEach(hide); }
function fmtMs(ms) { const e = new Date(ms); return `${pad2(e.getUTCMinutes())}:${pad2(e.getUTCSeconds())}.${String(e.getUTCMilliseconds()).padStart(3, '0')}`; }
function mk(tag, cls, html) { const e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }

window.addEventListener('mousemove', () => { state.mouseMoves++; });

