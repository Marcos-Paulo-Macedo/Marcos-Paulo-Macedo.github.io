<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RPA Challenger - 20 Níveis</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
/* ===== Paleta: 5 cores x 3 variações (1 = claro, 2 = base, 3 = escuro) ===== */
:root {
    --blue-1:#dbeafe;  --blue-2:#2563eb;  --blue-3:#1e3a8a;
    --green-1:#dcfce7; --green-2:#16a34a; --green-3:#14532d;
    --red-1:#fee2e2;   --red-2:#dc2626;   --red-3:#7f1d1d;
    --white-1:#ffffff; --white-2:#f4f6f8; --white-3:#d9dee4;
    --black-1:#0b0b0c; --black-2:#25272b; --black-3:#6b7076;
}
* { box-sizing: border-box; }
html, body { height: 100%; }
body { margin: 0; display: flex; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--white-2); color: var(--black-2); overflow: hidden; }
.hidden { display: none !important; }
button { font-family: inherit; }
h3, h4 { margin: 0; }

/* Sidebar */
.side { width: 272px; flex-shrink: 0; background: var(--black-1); color: var(--white-1); display: flex; flex-direction: column; border-right: 1px solid var(--black-2); }
.side-head { padding: 20px; text-align: center; border-bottom: 1px solid var(--black-2); }
.side-head h1 { margin: 0; font-size: 22px; font-weight: 900; letter-spacing: .04em; }
.side-head h1 span { color: var(--blue-2); }
.side-head small { display: block; margin-top: 6px; font-size: 11px; letter-spacing: .15em; text-transform: uppercase; color: var(--black-3); }
.levels { flex: 1; overflow-y: auto; padding: 8px 12px; }
.tier { font-size: 10px; font-weight: 900; letter-spacing: .15em; padding: 14px 8px 4px; }
.t-easy { color: var(--green-2); } .t-mid { color: var(--blue-2); } .t-hard { color: var(--white-3); } .t-insane { color: var(--red-2); } .t-lab { color: var(--white-1); }
.lvl { display: block; width: 100%; text-align: left; padding: 8px 14px; margin-bottom: 4px; border: 0; border-radius: 8px; background: transparent; color: var(--white-3); font-size: 14px; font-weight: 600; cursor: pointer; }
.lvl:hover { background: var(--black-2); color: var(--white-1); }
.lvl.active { background: var(--blue-2); color: var(--white-1); }
.lvl i { font-style: normal; opacity: .5; margin-right: 8px; }
.opts { border-top: 1px solid var(--black-2); font-size: 12px; color: var(--white-3); }
.opts summary { padding: 12px 16px; cursor: pointer; font-weight: 700; color: var(--black-3); text-transform: uppercase; letter-spacing: .08em; }
.opts .in { padding: 0 16px 16px; display: flex; flex-direction: column; gap: 10px; }
.opts input[type=text] { width: 100%; padding: 6px 8px; border-radius: 6px; border: 1px solid var(--black-3); background: var(--black-2); color: var(--white-1); margin-top: 4px; }
.opts button { padding: 8px; border: 0; border-radius: 6px; background: var(--black-2); color: var(--white-1); font-weight: 700; cursor: pointer; }
.opts p { margin: 0; color: var(--black-3); }

/* Main */
.main { flex: 1; overflow-y: auto; display: flex; flex-direction: column; min-width: 0; }
.top { position: sticky; top: 0; z-index: 10; height: 76px; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; background: var(--white-1); border-bottom: 1px solid var(--white-3); }
.top h2 { margin: 0; font-size: 19px; color: var(--black-1); }
.top p { margin: 2px 0 0; font-size: 13px; color: var(--black-3); max-width: 560px; }
.stats { display: flex; gap: 24px; }
.stat { text-align: right; }
.stat .k { font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--black-3); }
.stat .v { font-size: 22px; font-weight: 900; font-family: ui-monospace, Menlo, Consolas, monospace; color: var(--blue-2); }
.stat .v.ok { color: var(--green-2); } .stat .v.warn { color: var(--red-2); } .stat .v.dark { color: var(--black-2); }
.content { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; padding: 28px; }
.screen { width: 100%; max-width: 900px; margin: auto; }
.screen-form { max-width: 1000px; }
.card { background: var(--white-1); border: 1px solid var(--white-3); border-radius: 16px; padding: 32px; box-shadow: 0 4px 14px rgba(11,11,12,.08); }
.center { text-align: center; }
.lead { color: var(--black-3); font-size: 17px; line-height: 1.6; max-width: 640px; margin: 0 auto 16px; }
.h1 { font-size: 28px; font-weight: 900; margin-bottom: 12px; color: var(--black-1); }
.icon-circle { width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 28px; background: var(--blue-1); color: var(--blue-2); }
.icon-circle.big { width: 92px; height: 92px; font-size: 44px; border: 4px solid; }
.icon-circle.ok { background: var(--green-1); color: var(--green-2); border-color: var(--green-2); }
.icon-circle.bad { background: var(--red-1); color: var(--red-2); border-color: var(--red-2); }
.howto, .rules { text-align: left; max-width: 700px; margin: 0 auto 16px; padding: 16px 20px; border-radius: 12px; font-size: 14px; line-height: 1.55; }
.howto { background: var(--blue-1); border: 1px solid var(--blue-2); color: var(--blue-3); }
.rules { background: var(--white-2); border: 1px solid var(--white-3); color: var(--black-2); }
.howto h4, .rules h4 { margin-bottom: 8px; font-size: 14px; }
.howto ol, .rules ul { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 5px; }
.creds { max-width: 360px; margin: 0 auto 16px; text-align: left; font-size: 14px; background: var(--white-2); border: 1px solid var(--white-3); border-radius: 10px; padding: 12px 16px; font-family: ui-monospace, Menlo, Consolas, monospace; }
.creds b { font-family: system-ui, sans-serif; display: block; margin-bottom: 4px; color: var(--black-1); }
.row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 12px; }
.ok-text { color: var(--green-2); font-weight: 600; font-size: 14px; margin-top: 12px; }

/* Botões */
.btn { padding: 12px 28px; border: 0; border-radius: 8px; font-weight: 700; font-size: 15px; cursor: pointer; color: var(--white-1); background: var(--black-1); transition: transform .1s; }
.btn:hover { background: var(--black-2); } .btn:active { transform: scale(.97); }
.btn-blue { background: var(--blue-2); } .btn-blue:hover { background: var(--blue-3); }
.btn-green { background: var(--green-2); } .btn-green:hover { background: var(--green-3); }
.btn-red { background: var(--red-2); } .btn-red:hover { background: var(--red-3); }
.btn-light { background: var(--white-3); color: var(--black-2); } .btn-light:hover { background: var(--white-3); filter: brightness(.94); }
.btn-sm { padding: 8px 16px; font-size: 14px; }

/* Alertas */
.alert { padding: 10px 14px; border-radius: 10px; font-size: 14px; margin-bottom: 14px; }
.alert-warn { background: var(--blue-1); border: 1px solid var(--blue-2); color: var(--blue-3); font-weight: 600; }
.alert-err { background: var(--red-1); border: 1px solid var(--red-2); color: var(--red-3); font-weight: 500; }

/* Loader */
.loading { position: absolute; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(244,246,248,.9); }
.loader { border: 4px solid var(--white-3); border-top: 4px solid var(--blue-2); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin-bottom: 14px; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading p { font-weight: 700; color: var(--black-3); }

/* Login */
.login { max-width: 420px; }
.login label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 4px; }
.login-input { width: 100%; padding: 10px 12px; border: 1px solid var(--white-3); border-radius: 8px; margin-bottom: 14px; font-size: 15px; outline: none; }
.login-input:focus { border-color: var(--blue-2); box-shadow: 0 0 0 2px var(--blue-1); }
.link-btn { margin-top: 12px; background: none; border: 0; color: var(--black-3); text-decoration: underline; font-size: 12px; cursor: pointer; }

/* Barra de ferramentas e tabela de dados */
.toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--white-3); }
.toolbar .grp { display: flex; align-items: center; gap: 12px; }
.sent { font-size: 14px; font-weight: 700; color: var(--black-3); }
.tbl-card { margin-bottom: 20px; padding: 16px; border: 1px solid var(--white-3); border-radius: 12px; background: var(--white-2); }
.tbl-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.tbl-head input { padding: 7px 10px; border: 1px solid var(--white-3); border-radius: 8px; font-size: 14px; }
.tbl-wrap { overflow-x: auto; background: var(--white-1); border: 1px solid var(--white-3); border-radius: 8px; }
table.data { width: 100%; border-collapse: collapse; font-size: 13px; }
table.data th { text-align: left; padding: 8px 10px; background: var(--black-2); color: var(--white-1); white-space: nowrap; cursor: pointer; user-select: none; }
table.data td { padding: 7px 10px; border-top: 1px solid var(--white-3); white-space: nowrap; }
table.data tr:nth-child(even) td { background: var(--white-2); }
.col-hide { display: none; }
.tbl-foot { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 10px; font-size: 13px; }

/* Overlay / toast */
.ov-backdrop { position: fixed; inset: 0; background: rgba(11,11,12,.65); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 16px; }
.ov-modal { position: relative; background: var(--white-1); border-radius: 14px; padding: 24px; max-width: 26rem; width: 100%; box-shadow: 0 25px 50px -12px rgba(0,0,0,.45); }
.ov-btn { padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 14px; border: 1px solid var(--white-3); background: var(--white-1); cursor: pointer; }
.ov-btn.primary { background: var(--blue-2); color: var(--white-1); border-color: var(--blue-2); }
.ov-x { position: absolute; width: 20px; height: 20px; font-size: 11px; line-height: 18px; border-radius: 50%; background: var(--white-3); color: var(--black-2); text-align: center; cursor: pointer; border: 0; padding: 0; }
#toast-root { position: fixed; right: 16px; bottom: 16px; z-index: 120; display: flex; flex-direction: column; gap: 8px; }
.toast { background: var(--black-1); color: var(--white-1); padding: 12px 16px; border-radius: 8px; font-size: 14px; max-width: 20rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,.3); }

.res-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px; }
.res-box { background: var(--white-2); border: 1px solid var(--white-3); border-radius: 14px; padding: 18px; }
.res-box .k { font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: .1em; color: var(--black-3); margin-bottom: 6px; }
.res-box .v { font-size: 40px; font-weight: 900; color: var(--blue-2); }
.res-box .v.alt { color: var(--black-2); }
.details { text-align: left; font-size: 14px; color: var(--black-2); margin-bottom: 22px; display: flex; flex-direction: column; gap: 6px; }

@media (max-width: 800px) {
    body { flex-direction: column; overflow: auto; }
    .side { width: 100%; max-height: 220px; }
    .stats { gap: 12px; } .top { padding: 0 14px; } .content { padding: 14px; }
}
</style>
</head>
<body>

<!-- CSS dos formulários (injetado em light DOM, shadow DOM ou iframe) -->
<template id="form-styles">
<style>
    :host, :root {
        --blue-1:#dbeafe;  --blue-2:#2563eb;  --blue-3:#1e3a8a;
        --green-1:#dcfce7; --green-2:#16a34a; --green-3:#14532d;
        --red-1:#fee2e2;   --red-2:#dc2626;   --red-3:#7f1d1d;
        --white-1:#ffffff; --white-2:#f4f6f8; --white-3:#d9dee4;
        --black-1:#0b0b0c; --black-2:#25272b; --black-3:#6b7076;
    }
    * { box-sizing: border-box; font-family: system-ui, sans-serif; }
    .hidden { display: none !important; }
    .fgrid { display: grid; grid-template-columns: 1fr; gap: 20px; width: 100%; padding: 8px 0; }
    @media (min-width: 768px) { .fgrid { grid-template-columns: repeat(2, 1fr); } }
    .fspan2 { grid-column: 1 / -1; }
    .label { display: block; font-size: 14px; font-weight: 600; color: var(--black-2); margin-bottom: 4px; }
    .hint { display: block; font-size: 12px; color: var(--black-3); margin: -2px 0 6px; font-weight: 400; }
    .input-base { width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--white-3); background: var(--white-1); color: var(--black-2); font-size: 15px; outline: none; }
    .input-base:focus { border-color: var(--blue-2); box-shadow: 0 0 0 2px var(--blue-1); }
    textarea.input-base { resize: vertical; min-height: 64px; }
    input[type=color].input-base { padding: 2px; height: 42px; }
    .radio-group, .checkbox-group { display: flex; gap: 16px; margin-top: 8px; flex-wrap: wrap; }
    .radio-label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .invoice-box { background: var(--blue-1); border: 1px solid var(--blue-2); padding: 14px; border-radius: 10px; display: flex; align-items: center; justify-content: space-between; }
    .invoice-box .cap { font-size: 13px; font-weight: 700; color: var(--blue-3); display: block; margin-bottom: 4px; }
    .invoice-text { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 18px; font-weight: bold; color: var(--blue-3); background: var(--white-1); padding: 4px 8px; border-radius: 6px; }
    .ocr-canvas { background: var(--white-2); border: 2px dashed var(--black-3); border-radius: 8px; cursor: crosshair; }

    /* campos customizados (nível 7+) */
    .custom-input { width: 100%; min-height: 42px; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--black-3); background: var(--white-1); cursor: text; outline: none; }
    .custom-input:focus { border-color: var(--blue-3); box-shadow: 0 0 0 2px var(--blue-1); }
    .custom-radio-group { display: flex; gap: 12px; margin-top: 8px; flex-wrap: wrap; }
    .custom-radio { padding: 7px 16px; border: 1px solid var(--white-3); border-radius: 999px; cursor: pointer; user-select: none; background: var(--white-1); }
    .custom-radio.selected { background: var(--blue-3); color: var(--white-1); border-color: var(--blue-3); }
    .custom-check { display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; margin-top: 8px; }
    .custom-check-box { width: 20px; height: 20px; border: 2px solid var(--black-3); border-radius: 4px; display: flex; align-items: center; justify-content: center; background: var(--white-1); }
    .custom-check.selected .custom-check-box { background: var(--blue-3); border-color: var(--blue-3); }
    .custom-check.selected .custom-check-box::after { content: '✓'; color: var(--white-1); font-size: 13px; font-weight: bold; }
    .custom-select { position: relative; width: 100%; user-select: none; }
    .select-trigger { width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--white-3); background: var(--white-1); cursor: pointer; }
    .select-options { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--white-1); border: 1px solid var(--white-3); border-radius: 8px; margin-top: 4px; z-index: 50; box-shadow: 0 4px 6px rgba(11,11,12,.12); max-height: 150px; overflow-y: auto; }
    .select-options.open { display: block; }
    .select-item { padding: 10px 12px; cursor: pointer; }
    .select-item:hover { background: var(--blue-1); }

    /* componentes novos */
    .cmp-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; padding: 10px; border: 1px solid var(--white-3); border-radius: 8px; background: var(--white-1); }
    .cmp-row { display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 4px 6px; border-radius: 6px; }
    .cmp-row:hover { background: var(--blue-1); }
    select[multiple].input-base { padding: 6px; }
    .dd { position: relative; }
    .dd-trigger { width: 100%; text-align: left; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--black-3); background: var(--white-1); cursor: pointer; font-size: 15px; }
    .dd-trigger::after { content: '▾'; float: right; color: var(--black-3); }
    .dd-panel { position: absolute; z-index: 40; left: 0; right: 0; top: 100%; margin-top: 4px; padding: 6px; background: var(--white-1); border: 1px solid var(--black-3); border-radius: 8px; box-shadow: 0 8px 16px rgba(11,11,12,.18); }
    .combo { position: relative; }
    .combo-list { position: absolute; z-index: 40; left: 0; right: 0; top: 100%; margin: 4px 0 0; padding: 4px; list-style: none; background: var(--white-1); border: 1px solid var(--black-3); border-radius: 8px; max-height: 160px; overflow-y: auto; }
    .combo-list li { padding: 8px 10px; cursor: pointer; border-radius: 6px; }
    .combo-list li:hover { background: var(--blue-1); }
    .slider { display: flex; align-items: center; gap: 12px; }
    .slider input { flex: 1; accent-color: var(--blue-2); }
    .slider output { min-width: 28px; text-align: right; font-weight: 800; color: var(--blue-3); }
    .switch-wrap { display: flex; align-items: center; gap: 10px; }
    .switch { position: relative; width: 52px; height: 28px; border-radius: 999px; border: 0; background: var(--black-3); cursor: pointer; padding: 0; }
    .switch .knob { position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: var(--white-1); transition: left .15s; }
    .switch.on { background: var(--green-2); } .switch.on .knob { left: 27px; }
    .switch-text { font-size: 14px; color: var(--black-3); }
    .stars { display: flex; gap: 4px; }
    .star { border: 0; background: none; font-size: 28px; line-height: 1; color: var(--white-3); cursor: pointer; padding: 0 2px; }
    .star.on { color: var(--blue-2); }
    .stepper { display: inline-flex; align-items: center; border: 1px solid var(--black-3); border-radius: 8px; overflow: hidden; background: var(--white-1); }
    .stepper button { width: 40px; height: 40px; border: 0; background: var(--white-2); font-size: 20px; cursor: pointer; }
    .stepper button:hover { background: var(--blue-1); }
    .stepper output { min-width: 48px; text-align: center; font-weight: 800; }
    .seg { display: inline-flex; border: 1px solid var(--black-3); border-radius: 8px; overflow: hidden; }
    .seg-btn { padding: 9px 16px; border: 0; background: var(--white-1); cursor: pointer; font-size: 14px; border-right: 1px solid var(--white-3); }
    .seg-btn:last-child { border-right: 0; }
    .seg-btn.on { background: var(--blue-2); color: var(--white-1); }
    .pin { display: flex; gap: 10px; }
    .pin-box { width: 48px; height: 52px; text-align: center; font-size: 22px; font-weight: 800; border: 2px solid var(--black-3); border-radius: 8px; outline: none; }
    .pin-box:focus { border-color: var(--blue-2); }
    .tags { padding: 8px; border: 1px solid var(--black-3); border-radius: 8px; background: var(--white-1); display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .tag-chips { display: contents; }
    .chip { display: inline-flex; align-items: center; gap: 6px; background: var(--blue-1); color: var(--blue-3); border-radius: 999px; padding: 4px 6px 4px 12px; font-size: 13px; font-weight: 600; }
    .chip-x { border: 0; background: var(--blue-2); color: var(--white-1); width: 18px; height: 18px; border-radius: 50%; font-size: 12px; line-height: 16px; cursor: pointer; padding: 0; }
    .tag-input { flex: 1; min-width: 140px; border: 0; outline: none; padding: 6px; font-size: 14px; }
    .dnd { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .dnd-title { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--black-3); margin-bottom: 6px; }
    .dnd-src, .dnd-zone { min-height: 150px; padding: 8px; border-radius: 10px; display: flex; flex-direction: column; gap: 6px; }
    .dnd-src { background: var(--white-2); border: 2px solid var(--white-3); }
    .dnd-zone { background: var(--green-1); border: 2px dashed var(--green-2); }
    .dnd-item { padding: 9px 12px; background: var(--white-1); border: 1px solid var(--black-3); border-radius: 8px; cursor: grab; user-select: none; font-weight: 600; }
    .dnd-item.dragging { background: var(--blue-1); border-color: var(--blue-2); cursor: grabbing; }
    .sortl { padding: 10px; border: 1px solid var(--white-3); border-radius: 10px; background: var(--white-2); }
    .sort-ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .sort-item::before { content: '⋮⋮'; margin-right: 10px; color: var(--black-3); }

    /* widgets de extração */
    .src-box { border: 1px solid var(--white-3); background: var(--white-2); border-radius: 10px; padding: 10px; margin-bottom: 8px; }
    .src-title { font-size: 12px; font-weight: 700; color: var(--black-3); margin-bottom: 6px; }
    .src-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 6px 10px; border-radius: 6px; background: var(--white-1); border: 1px solid var(--white-3); margin-bottom: 4px; font-size: 14px; }
    .src-inv { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; }
