   ===================================================================== */
function genExtras() {
    const code = p => `${p}-${1000 + Math.floor(rng() * 9000)}`;
    return {
        Skills: subset(OPT.Skills, 2, 4), Languages: subset(OPT.Languages, 1, 3), Interests: subset(OPT.Interests, 1, 3),
        Plan: pick(OPT.Plan), Country: pick(OPT.Countries),
        Experience: String(1 + Math.floor(rng() * 19)), Remote: rng() > .5 ? 'Yes' : 'No', Rating: String(1 + Math.floor(rng() * 5)),
        StartDate: `2026-${pad2(1 + Math.floor(rng() * 12))}-${pad2(1 + Math.floor(rng() * 28))}`,
        Time: `${pad2(8 + Math.floor(rng() * 10))}:${pick(['00', '15', '30', '45'])}`,
        Color: pick(OPT.Colors), Notes: pick(OPT.Notes), Quantity: String(1 + Math.floor(rng() * 9)), Billing: pick(OPT.Billing),
        PIN: String(Math.floor(rng() * 10000)).padStart(4, '0'), Labels: subset(OPT.Tags, 1, 3),
        Priority: shuffle(OPT.Tasks, rng).slice(0, 3).join('>'), Ranking: shuffle(OPT.Ranks, rng).join('>'),
        HoverCode: code('H'), CtxCode: code('C'), DblCode: code('D'), ScrollCode: code('S')
    };
}

function genSeq() {
    const out = [];
    for (let i = 0; i < 5; i++) {
        const f = pick(MOCK.fnames), l = pick(MOCK.lnames);
        out.push(Object.assign({
            FirstName: f, LastName: l, Email: `${f.toLowerCase()}.${l.toLowerCase()}@test.com`,
            Phone: `+1555${Math.floor(1000000 + rng() * 9000000)}`, Company: pick(MOCK.companies), Role: pick(MOCK.roles),
            SkillRPA: rng() > .5 ? 'Yes' : 'No', SkillJS: rng() > .5 ? 'Yes' : 'No', Department: pick(MOCK.deps),
            InvoiceNumber: `INV-${Math.floor(10000 + rng() * 89999)}`, valid: true
        }, genExtras()));
    }
    return out;
}

function cpfDigits(base) {
    const d = base.slice();
    for (let t = 9; t <= 10; t++) { let sum = 0; for (let i = 0; i < t; i++) sum += d[i] * (t + 1 - i); d.push(((sum * 10) % 11) % 10); }
    return d;
}
function genCpf(valid) {
    let base; do { base = Array.from({ length: 9 }, () => Math.floor(rng() * 10)); } while (base.every(x => x === base[0]));
    const d = cpfDigits(base);
    if (!valid) d[10] = (d[10] + 1 + Math.floor(rng() * 8)) % 10;
    return d.join('');
}
const fmtCpf = s => `${s.slice(0, 3)}.${s.slice(3, 6)}.${s.slice(6, 9)}-${s.slice(9)}`;
function cpfValid(s) {
    if (!/^\d{3}\.\d{3}\.\d{3}-\d{2}$/.test(s)) return false;
    const d = s.replace(/\D/g, '').split('').map(Number);
    if (d.every(x => x === d[0])) return false;
    const c = cpfDigits(d.slice(0, 9));
    return c[9] === d[9] && c[10] === d[10];
}

function genQueue(L) {
    const n = L.total, A = L.anomalies || {};
    const roles = new Array(n).fill('OK'), dupOf = {};
    const idx = shuffle([...Array(n).keys()], rng); let p = 0;
    for (let i = 0; i < (A.cancel || 0); i++) roles[idx[p++]] = 'CANCELADO';
    for (let i = 0; i < (A.cpf || 0); i++) roles[idx[p++]] = 'CPF_INVALIDO';
    const cands = shuffle([...Array(n).keys()].filter(i => i >= 1 && roles[i] === 'OK'), rng);
    let made = 0;
    for (const j of cands) {
        if (made >= (A.dup || 0)) break;
        const src = [...Array(j).keys()].filter(i => roles[i] === 'OK');
        if (!src.length) continue;
        roles[j] = 'DUPLICADO'; dupOf[j] = pick(src); made++;
    }
    const rows = [];
    for (let i = 0; i < n; i++) {
        let fn = pick(MOCK.fnames), ln = pick(MOCK.lnames), email = `${fn}.${ln}${i + 1}@example.com`.toLowerCase();
        if (roles[i] === 'DUPLICADO') { const s = rows[dupOf[i]]; fn = s.FirstName; ln = s.LastName; email = s.Email; }
        const company = pick(MOCK.companies), role = pick(MOCK.roles), dept = pick(MOCK.deps);
        const rpa = rng() > .5 ? 'Yes' : 'No', js = rng() > .5 ? 'Yes' : 'No';
        const phone = `+55419${Math.floor(10000000 + rng() * 89999999)}`;
        const invoice = `INV-${20000 + i * 97 + Math.floor(rng() * 90)}`;
        const cpfRaw = genCpf(roles[i] !== 'CPF_INVALIDO');
        const v = Math.round((100 + rng() * 9900) * 100) / 100;
        const y = pick([2024, 2025]), m = 1 + Math.floor(rng() * 12), d = 1 + Math.floor(rng() * 28);
        const iso = `${y}-${pad2(m)}-${pad2(d)}`;
        const padS = s => rng() < .3 ? `  ${s} ` : s;
        const status = roles[i] === 'CANCELADO' ? (rng() < .5 ? 'CANCELADO' : 'cancelado') : (rng() < .3 ? 'Ativo ' : 'ATIVO');
        rows.push(Object.assign({
            FirstName: fn, LastName: ln, Email: email, Phone: phone, Company: company, Role: role, SkillRPA: rpa, SkillJS: js, Department: dept,
            InvoiceNumber: invoice, CPF: fmtCpf(cpfRaw),
            Amount: v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
            Date: `${pad2(d)}/${pad2(m)}/${y}`,
            valid: roles[i] === 'OK', reason: roles[i] === 'OK' ? '' : roles[i], processed: false, fieldsOk: 0,
            raw: {
                Nome: padS(fn), Sobrenome: padS(ln), Email: rng() < .2 ? email.toUpperCase() : padS(email), Telefone: phone, Empresa: padS(company),
                Cargo: role, RPA: rpa === 'Yes' ? 'Sim' : 'Não', JavaScript: js === 'Yes' ? 'Sim' : 'Não', Departamento: dept,
                Fatura: invoice, CPF: cpfRaw, Valor: v, Data: iso, Status: status
            }
        }, genExtras()));
    }
    return rows;
}
function generateDataset(L) { return L.mode === 'queue' ? genQueue(L) : genSeq(); }

