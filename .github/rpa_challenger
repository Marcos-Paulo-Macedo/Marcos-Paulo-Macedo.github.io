/* =====================================================================
   SESSÃO, LOGIN E 2FA
   ===================================================================== */
function rotateCsrf() { state.csrf = 'csrf_' + Math.random().toString(36).substr(2, 12); $('login-csrf').value = state.csrf; }
function loginError(msg) { const e = $('login-error'); e.innerText = msg; show('login-error'); }

function showLogin(banner) {
    state.phase = 'login'; clearTimeout(state.intTimer); $('overlay-root').innerHTML = '';
    hideAllScreens(); show('screen-login');
    const b = $('login-banner'); if (banner) { b.innerText = banner; show('login-banner'); } else hide('login-banner');
    hide('login-error');
    $('login-user').value = ''; $('login-pass').value = ''; $('twofa-code').value = '';
    show('login-form'); hide('twofa-form'); rotateCsrf(); state.codeFails = 0;
    $('session-val').innerText = '--:--';
}

window.doLogin = function (e) {
    e.preventDefault();
    if ($('login-csrf').value !== state.csrf) { loginError('Token CSRF inválido ou expirado.'); rotateCsrf(); log('login_csrf_fail'); return false; }
    if ($('login-user').value.trim() !== LOGIN.user || $('login-pass').value !== LOGIN.pass) {
        state.loginFails++; loginError('Usuário ou senha inválidos.'); rotateCsrf(); $('login-pass').value = ''; log('login_fail'); return false;
    }
    hide('login-error');
    if (curLevel().flags.twofa) { hide('login-form'); show('twofa-form'); send2FA(); } else completeLogin();
    return false;
};

window.send2FA = function () {
    state.code = String(Math.floor(100000 + Math.random() * 900000)); state.codeExp = Date.now() + 30000;
    document.querySelectorAll('#toast-2fa').forEach(t => t.remove());
    showToast(`📧 Código de verificação: ${state.code} (válido por 30s)`, 8000, 'toast-2fa');
    log('2fa_sent');
};

window.do2FA = function (e) {
    e.preventDefault();
    if (Date.now() > state.codeExp) { loginError('Código expirado. Solicite um novo.'); return false; }
    if ($('twofa-code').value.trim() !== state.code) {
        state.codeFails++; log('2fa_fail');
        if (state.codeFails >= 3) { showLogin('Muitas tentativas de 2FA. Refaça o login.'); return false; }
        loginError(`Código incorreto (${state.codeFails}/3).`); return false;
    }
    document.querySelectorAll('#toast-2fa').forEach(t => t.remove());
    completeLogin(); return false;
};

function completeLogin() {
    const ttl = curLevel().session.ttl;
    state.session = { active: true, expiresAt: Date.now() + ttl * 1000 };
    log('login_ok', { ttl });
    hide('screen-login'); state.phase = 'work';
    if (state.view === 'upload') { show('screen-upload'); return; }
    if (!state.recordActive) newRecord(); else renderForm();
}

function sessionTick() {
    if (!state.session.active) return;
    const left = state.session.expiresAt - Date.now(), s = Math.max(0, Math.ceil(left / 1000));
    const el = $('session-val'); el.innerText = `${pad2(Math.floor(s / 60))}:${pad2(s % 60)}`;
    el.className = 'v ' + (s <= 10 ? 'warn' : 'ok');
    if (left <= 0) expireSession('Sua sessão expirou por tempo limite. Faça login novamente.');
}

function expireSession(msg) {
    if (state.phase !== 'work') return;
    state.session.active = false; state.expirations++; state.draft = {}; state.step = 1; state.tbl = null;
    $('form-host').innerHTML = ''; hide('table-card'); log('session_expired');
    showLogin(msg || 'Sessão expirada.');
}

function ensureSession() {
    if (curLevel().flags.session && !state.session.active) { expireSession('Sessão expirada. Faça login novamente.'); return false; }
    return true;
}

